# Main database
DATABASE_URL=postgres://app:app@localhost:5432/checkout

# Test database (reset per test file). Tests only.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/checkout_test

# HTTP port
PORT=3000

# n: a coupon becomes available at every nth placed order (integer >= 1)
COUPON_EVERY_N_ORDERS=5

# x: discount percent for newly generated coupons (integer 1..100)
COUPON_PERCENT=10

# Generate the milestone coupon inside the nth order's checkout (boolean)
AUTO_GENERATE_COUPONS=true

# Postgres pool size. Must be >= the test concurrency so requests overlap.
PG_POOL_MAX=20
